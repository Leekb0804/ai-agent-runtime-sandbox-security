#!/bin/bash
#
# tools/mock/myc_loader  -  가짜 로더 (러너의 흐름을 테스트하려는 용도, 실제 감시는 하지 않는다)
#
# 진짜 로더와 같은 약속만 지킨다.
#   - 준비되면 stderr 에 "[loader] ready ..." 를 낸다
#   - SIGTERM 이나 SIGINT 를 받으면 "[loader] log stats: ... lost=N" 를 내고,
#     이어서 "[loader] ring buffer drops: exec=N tag_hit=M" 를 낸 뒤 종료한다 (src/loader/loader.c 의 report_drops 와 같은 형식)
# MOCK_MODE=noready : 준비되지 못하고 바로 죽는 로더 (러너가 시작을 거부하는지 확인)
# MOCK_MODE=hang    : 준비 메시지를 내지 않고 살아 있는 로더 (BPF 로드가 멈춘 경우. 러너가 시간 초과 뒤 로더를 끄는지 확인)
#                     종료 신호를 받으면 평소처럼 끝나고, 받지 못해도 30초 뒤 스스로 끝난다 (테스트가 깨졌을 때 고아가 오래 남지 않게)
# MOCK_LOST=N       : 종료 시 lost=N 을 보고하는 로더 (러너의 인프라 검증이 잡아내는지 확인)
# MOCK_DROPS_EXEC=N : 종료 시 exec 드롭을 N 으로 보고 (기본 0)
# MOCK_DROPS_TAG=N  : 종료 시 tag_hit 드롭을 N 으로 보고 (기본 0)
# MOCK_DROPS=fail   : 드롭 줄을 "확인 실패" 로 낸다 (로더가 드롭 맵을 읽지 못한 경우를 흉내냄)
# MOCK_DROPS=none   : 드롭 줄을 아예 내지 않는다 (드롭을 출력하지 않는 옛 로더를 흉내냄)
# MOCK_DROPS=garbage: 드롭 줄은 내지만 "확인 실패" 도 exec=/tag_hit= 숫자도 없다 (줄 형식이 바뀐 경우를 흉내냄)
# MOCK_MODE=oldready : ready 줄을 옛 형식 "[loader] ready (sessions root: X)" 로 낸다 (옛 로더를 러너가 거부하는지 확인)
# MOCK_READY_DETECTORS=<값> : ready 줄의 detectors 에 받은 목록 대신 이 값을 찍는다 (탐지기가 다르게 켜진 로더를 흉내냄)
# MOCK_READY_MODE=<값>      : ready 줄의 mode 에 이 값을 찍는다 (다른 모드로 뜬 로더를 흉내냄). --no-kill 보다 우선한다
# MOCK_LOADER_RECORD=<파일> : 받은 인자를 한 줄에 하나씩, 이어서 이 프로세스의 PID 를 "pid=<번호>" 로 그 파일에 쓴다
#                            (러너가 넘긴 인자와, 러너가 끝난 뒤 로더가 정리됐는지를 테스트가 확인하려는 용도)

# 진짜 로더와 같은 인자를 받는다: [세션 루트] [--detectors=a,b,c] [--no-kill] (순서 상관없음).
# 세션 루트와 탐지기 목록. 인자가 없으면 빈 문자열로 둔다
root=""
detectors=""
# ready 줄에 찍을 모드. 진짜 로더처럼 기본은 kill, --no-kill 이면 observe (러너는 --no-kill 을 넘기지 않는다)
mode="kill"
# "$@" 는 받은 인자 전체이다. 하나씩 arg 에 넣어 돈다
for arg in "$@"; do
    case "$arg" in
        # --detectors=값 : = 뒤의 값만 남긴다 (${arg#패턴} 은 앞에서 패턴을 떼어 낸 값)
        --detectors=*) detectors="${arg#--detectors=}" ;;
        # --no-kill : 관찰 모드. 값이 붙은 --no-kill=… 는 아래의 -* 에 걸려 거부된다
        --no-kill) mode="observe" ;;
        # 그 밖의 - 로 시작하는 인자는 진짜 로더처럼 거부하고 종료 코드 2 로 끝낸다
        -*) echo "[loader] 인자 오류: 알 수 없는 옵션: $arg" >&2; exit 2 ;;
        # 나머지는 세션 루트
        *) root="$arg" ;;
    esac
done
# 기록 파일이 지정되었으면 받은 인자와 PID 를 남긴다. $$ 는 이 셸(가짜 로더)의 PID
if [[ -n "${MOCK_LOADER_RECORD:-}" ]]; then
    # printf '%s\n' "$@" : 인자를 한 줄에 하나씩 쓴다
    { printf '%s\n' "$@"; echo "pid=$$"; } >"$MOCK_LOADER_RECORD"
fi
# ready 줄에 찍을 목록: 받은 목록을 알파벳순으로 (진짜 로더의 dispatcher_selected_names 와 같은 순서). LC_ALL=C 는 바이트 순서
sorted="$(tr ',' '\n' <<<"$detectors" | LC_ALL=C sort | paste -sd, -)"
# MOCK_READY_DETECTORS 가 있으면 그 값으로 바꿔 찍는다
ready_dets="${MOCK_READY_DETECTORS:-$sorted}"

# MOCK_MODE=noready 이면 준비 메시지 없이 오류를 내고 종료 코드 1 로 바로 끝난다.
# 러너의 "로더가 준비되지 못함 -> 시작을 거부" 경로를 시험하려는 것이다.
if [[ "${MOCK_MODE:-}" == "noready" ]]; then
    echo "[loader] mock: BPF 로드 실패를 흉내냄" >&2
    exit 1
fi

# 종료 신호를 받았을 때 실행할 함수. 진짜 로더처럼 log stats 줄과 ring buffer drops 줄을 stderr 로 내고 정상 종료(0)한다.
# 함수 안의 ${변수:-기본값} 은 신호를 받아 이 함수가 실행되는 시점에 값으로 바뀐다.
on_term() {
    # log stats 줄을 낸다. ${MOCK_LOST:-0} : 환경변수가 없으면 0.
    echo "[loader] log stats: writes=0 slow(>5ms)=0 max=0us lost=${MOCK_LOST:-0}" >&2
    # case 값 in 패턴) ... ;; esac : 값이 어느 패턴과 맞는지에 따라 갈라진다. MOCK_DROPS 가 없으면 빈 문자열로 본다.
    case "${MOCK_DROPS:-}" in
        # none : 드롭 줄을 내지 않는다. : 는 아무 일도 하지 않는 명령이다.
        none) : ;;
        # fail : 진짜 로더가 드롭 맵을 읽지 못했을 때 내는 줄 (loader.c:112 와 같은 문구).
        fail) echo "[loader] ring buffer drops: 확인 실패" >&2 ;;
        # garbage : 'ring buffer drops' 는 들어 있지만 러너가 숫자를 뽑을 수 없는 줄.
        garbage) echo "[loader] ring buffer drops: 알 수 없음" >&2 ;;
        # 그 밖 (기본) : 진짜 로더가 읽기에 성공했을 때 내는 줄 (loader.c:109 와 같은 형식). 값이 없으면 0.
        *) echo "[loader] ring buffer drops: exec=${MOCK_DROPS_EXEC:-0} tag_hit=${MOCK_DROPS_TAG:-0}" >&2 ;;
    esac
    # 정상 종료(0)한다.
    exit 0
}
# trap '명령' TERM INT : SIGTERM (러너가 보내는 종료 요청)이나 SIGINT (Ctrl+C)를 받으면 작은따옴표 안의 명령(on_term)을 실행한다.
# loader.c 의 on_sig 와 그 뒤 종료 처리를 합친 역할이다.
trap 'on_term' TERM INT

# MOCK_MODE=hang : 준비 메시지를 내지 않고 종료 신호를 기다린다. 위의 trap 을 건 뒤라서 신호를 받으면 on_term 이 끝낸다
if [[ "${MOCK_MODE:-}" == "hang" ]]; then
    # 0.1 초씩 300 번 = 약 30초. 이 안에 신호가 오지 않으면 안전장치로 스스로 끝난다
    for ((n = 0; n < 300; n++)); do
        # 쉬는 동안 신호가 오면 sleep 이 끝난 뒤 on_term 이 실행된다
        sleep 0.1
    done
    # 여기까지 왔다면 아무도 이 로더를 끄지 않은 것이다. 흔적을 남기고 오류(1)로 끝낸다
    echo "[loader] mock: hang 30초 안전장치로 스스로 종료" >&2
    # 신호로 끝난 것과 구분하려고 0 이 아닌 값으로 끝낸다
    exit 1
fi

# 준비 메시지. >&2 로 stderr 에 낸다. 러너가 loader.err 파일에서 이 줄을 찾고 mode 와 detectors 를 비교한다.
if [[ "${MOCK_MODE:-}" == "oldready" ]]; then
    # 옛 형식 (mode, detectors 가 없음)
    echo "[loader] ready (sessions root: $root)" >&2
else
    # 진짜 로더(src/loader/loader.c)와 같은 형식
    # mode 는 MOCK_READY_MODE 가 있으면 그 값, 없으면 받은 인자로 정한 값
    echo "[loader] ready (sessions root: $root, mode: ${MOCK_READY_MODE:-$mode}, detectors: $ready_dets)" >&2
fi
# while true; do ... done : 종료 신호를 받을 때까지 영원히 반복한다. 아무 일도 하지 않고 0.1 초씩 쉬며 대기하는 것이다.
# 진짜 로더의 ring_buffer__poll 루프를 대신한다. 쉘은 sleep 이 끝난 뒤에 trap 을 실행하므로 종료에는 최대 0.1 초가 걸린다.
while true; do
    sleep 0.1
done
